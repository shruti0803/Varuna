{
  "compilerOptions": {
    // Environment Settings
    "target": "ES2020",               // Modern enough for Node
    "module": "nodenext",             // Required for ES modules in Node
    "moduleResolution": "node",       // Node-style module resolution
    "esModuleInterop": true,          // Makes CommonJS imports compatible
    "forceConsistentCasingInFileNames": true,
    
    // Type checking
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Node types
    "types": ["node"],                // Include Node.js types
    "skipLibCheck": true,

    // Module handling
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",

    // React (if you have any frontend code in this repo)
    "jsx": "react-jsx"
  }
}
